# MongoDB connection string (local MongoDB or MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/teamsync

# Replace with a long, random secret before running the application
JWT_SECRET=replace-this-with-a-long-random-secret

# Frontend origin used for CORS and invitation links
CLIENT_URL=http://localhost:5173

# Calendar timezone used for deadline reminders and past-date validation
APP_TIME_ZONE=Asia/Kolkata

PORT=5000
